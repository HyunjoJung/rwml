ARG SOURCE_DATE_EPOCH=1783900800
FROM docker.io/library/debian:bookworm-slim@sha256:63a496b5d3b99214b39f5ed70eb71a61e590a77979c79cbee4faf991f8c0783e
ARG SOURCE_DATE_EPOCH
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC \
    SAL_USE_VCLPLUGIN=svp SAL_DISABLE_OPENCL=1
COPY libreoffice.tar.gz /tmp/libreoffice.tar.gz
RUN set -eux; \
    test "$(dpkg --print-architecture)" = amd64; \
    test "$(wc -c < /tmp/libreoffice.tar.gz)" = 216816909; \
    printf '%s  %s\n' '18838cb9d028b664a9d0e966cd4c8ca47ca3ea363c393b41d1b5124740b121a5' /tmp/libreoffice.tar.gz | sha256sum --check --strict -; \
    printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260713T000000Z bookworm main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260713T000000Z bookworm-updates main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260713T000000Z bookworm-security main' \
      > /etc/apt/sources.list; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends \
      ca-certificates fontconfig libcairo2=1.16.0-7 libcups2=2.4.2-3+deb12u9 \
      libdbus-1-3=1.14.10-1~deb12u1 libglib2.0-0=2.74.6-2+deb12u9 \
      libnss3=2:3.87.1-1+deb12u2 libx11-xcb1=2:1.8.4-2+deb12u2 libxinerama1=2:1.1.4-3; \
    mkdir /tmp/libreoffice; \
    tar -xzf /tmp/libreoffice.tar.gz -C /tmp/libreoffice --no-same-owner --no-same-permissions; \
    apt-get install -y --no-install-recommends /tmp/libreoffice/*/DEBS/*.deb; \
    ldd /opt/libreoffice26.2/program/oosplash /opt/libreoffice26.2/program/soffice.bin > /tmp/ldd.txt 2>&1; \
    grep_status=0; \
    grep -F '=> not found' /tmp/ldd.txt > /tmp/missing.txt || grep_status=$?; \
    test "$grep_status" = 1; \
    /opt/libreoffice26.2/program/soffice --headless --version > /tmp/version.txt; \
    test "$(cat /tmp/version.txt)" = 'LibreOffice 26.2.3.2 70e089b17412e4cb7773e41413306b17a2328c34'; \
    find /usr /opt -type f \( \
      -iname '*.ttf' -o -iname '*.otf' -o -iname '*.ttc' -o -iname '*.otc' -o \
      -iname '*.pfa' -o -iname '*.pfb' -o -iname '*.afm' -o -iname '*.pcf' -o \
      -iname '*.pcf.gz' -o -iname '*.bdf' -o -iname '*.woff' -o -iname '*.woff2' \
      \) -delete; \
    find /usr /opt -type f \( \
      -iname '*.ttf' -o -iname '*.otf' -o -iname '*.ttc' -o -iname '*.otc' -o \
      -iname '*.pfa' -o -iname '*.pfb' -o -iname '*.afm' -o -iname '*.pcf' -o \
      -iname '*.pcf.gz' -o -iname '*.bdf' -o -iname '*.woff' -o -iname '*.woff2' \
      \) > /tmp/image-fonts.txt; \
    test ! -s /tmp/image-fonts.txt; \
    rm -rf /tmp/libreoffice /tmp/libreoffice.tar.gz /tmp/ldd.txt /tmp/missing.txt /tmp/version.txt /tmp/image-fonts.txt \
      /root/.cache/fontconfig /root/.config/libreoffice /var/lib/apt/lists/* \
      /var/cache/apt/* /var/cache/debconf/* /var/cache/fontconfig/*; \
    rm -f /var/cache/ldconfig/aux-cache /var/lib/dpkg/status-old /var/log/alternatives.log /var/log/dpkg.log /var/log/apt/*
COPY --chmod=0444 capture.sh fonts.conf profile.xcu /opt/rwml-oracle/
RUN set -eux; chmod 0555 /opt/rwml-oracle /opt/rwml-oracle/capture.sh; \
    mkdir -p /oracle/source /oracle/fonts /oracle/output; \
    chmod 0555 /oracle /oracle/source /oracle/fonts /oracle/output
LABEL org.opencontainers.image.title="rwml LibreOffice Writer diagnostic oracle" \
      org.opencontainers.image.version="26.2.3.2" \
      org.rwml.libreoffice-artifact-sha256="18838cb9d028b664a9d0e966cd4c8ca47ca3ea363c393b41d1b5124740b121a5"
USER 65534:65534
WORKDIR /oracle
ENTRYPOINT ["/opt/rwml-oracle/capture.sh"]
